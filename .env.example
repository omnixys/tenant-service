SERVICE=tenant
NODE_ENV=development
PORT=3000

# Logging
LOG_DEFAULT=true
LOG_DIRECTORY=log
LOG_FILE_DEFAULT_NAME=server.log
LOG_PRETTY=true
LOG_LEVEL=info

# HTTPS
HTTPS=false
KEYS_PATH=./keys

# Tracing
TEMPO_URI=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Health
TEMPO_HEALTH_URL=http://localhost:4318/ready
PROMETHEUS_HEALTH_URL=

# Database (own postgres database "tenant")
DATABASE_URL=postgresql://tenant:tenant@127.0.0.1:5432/tenant

# Bootstrap tenant (canonical default tenant)
DEFAULT_TENANT_ID=6e788f7f-c233-4cb8-bbde-c0b855e564be

# gRPC server (internal)
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# gRPC caller authentication (per-caller service tokens)
# Tenant service validates the presented bearer token and maps it to a caller identity.
TENANT_GRPC_AUTHENTICATION_TOKEN=dev-authentication-service-token
TENANT_GRPC_GATEWAY_TOKEN=dev-gateway-service-token
TENANT_GRPC_SERVICE_TOKEN=dev-tenant-service-token

# Authorized callers per operation group (comma separated)
TENANT_GRPC_READ_CALLERS=authentication,gateway,service
TENANT_GRPC_WRITE_CALLERS=authentication

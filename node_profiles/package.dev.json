{
  "name": "tenant-service",
  "version": "1.0.0",
  "description": "Omnixys tenant service - authoritative source for tenants and memberships",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "start": "pnpm nest start",
    "dev": "pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "pnpm run build && node --test __tests__/unit/*.test.mjs",
    "test:unit": "pnpm run build && node --test __tests__/unit/*.test.mjs",
    "test:integration": "pnpm run build && node --test __tests__/integration/*.test.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "tsx prisma/validate.ts",
    "prisma:push": "prisma db push",
    "generate": "pnpm prisma format && pnpm prisma validate && prisma generate",
    "reset": "prisma migrate reset --force && prisma migrate dev && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/terminus": "^11.1.1",
    "@omnixys/context-ts": "file:../../packages/ts/context",
    "@omnixys/contracts-ts": "file:../../packages/ts/contracts",
    "@omnixys/grpc-ts": "file:../../packages/ts/grpc",
    "@omnixys/http-ts": "file:../../packages/ts/http",
    "@omnixys/logger-ts": "file:../../packages/ts/logger",
    "@omnixys/observability-ts": "file:../../packages/ts/observability",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "graphql": "^16.13.2",
    "jose": "^6.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@tsconfig/node23": "^23.0.4",
    "@types/node": "^22.20.0",
    "prettier": "^3.9.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
